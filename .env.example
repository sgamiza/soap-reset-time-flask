# MYSQL_USER=YOUR_USER
# MYSQL_PASSWORD=YOUR_SECRET
# MYSQL_DATABASE=reset_time
# RESET_TIME_PLATFORM=

# Optional parser/importer overrides
# SOAP_PARSER_CONFIG=config/soap_parser_config.json
# IMPORTER_CONFIG=config/importer_config.json
