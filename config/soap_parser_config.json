{
  "PTP sync time between RU and DU": {
    "column": "ptp_sync",
    "start": {
      "xml_tag_name": "moduleReadyAck",
      "msg_from": "BTS",
      "msg_to": "RU"
    },
    "end": {
      "xml_tag_name": "managedObject",
      "msg_from": "RU",
      "msg_to": "BTS",
      "xml_tag_attrib": {
        "class": "PtpStatus",
        "distName": "ptpStatus"
      },
      "managed_parameter_change": {
        "parameterName": "lockState",
        "newValue": "LOCKED"
      },
      "should_contain_list": ["update_parm"]
    }
  },
  "Radio data path sync time": {
    "column": "path_sync",
    "start": {
      "xml_tag_name": "moduleReadyAck",
      "msg_from": "BTS",
      "msg_to": "RU"
    },
    "end": {
      "xml_tag_name": "managedObject",
      "msg_from": "RU",
      "msg_to": "BTS",
      "xml_tag_attrib": {
        "class": "Synchronization",
        "distName": "synchronization"
      },
      "managed_parameter_change": {
        "parameterName": "state",
        "newValue": "LOCKED",
        "prevValue": "FREERUN"
      },
      "should_contain_list": ["update_parm"],
      "check_status": true
    }
  },
